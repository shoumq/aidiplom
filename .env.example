# AITunnel
AITUNNEL_API_KEY=
AITUNNEL_TIMEOUT=900
AITUNNEL_MAX_RETRIES=5

# Production security. Use HTTPS and set COOKIE_SECURE=1 in production.
COOKIE_SECURE=1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATA_RETENTION_DAYS=365

# Keep enabled only while payment is being tested. Set to 0 before launch.
ALLOW_MOCK_PAY=1

# Public legal details shown in the privacy policy.
NUXT_PUBLIC_OPERATOR_NAME=
NUXT_PUBLIC_OPERATOR_EMAIL=
NUXT_PUBLIC_OPERATOR_ADDRESS=
# Serve the API behind the same public host at /api (reverse proxy to backend:8000).
NUXT_PUBLIC_API_BASE=/api
